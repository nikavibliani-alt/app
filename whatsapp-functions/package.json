{
  "name": "whatsapp-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for WhatsApp (Meta) guest messaging — split out of tuya-functions/, which is reserved for Tuya smart lock integration.",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "deploy": "FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase deploy --only functions:whatsapp --project sleepy-5c962",
    "loadcheck": "node -e \"const s=Date.now(); require('./index.js'); console.log('ok', Object.keys(require('./index.js')).join(','), Date.now()-s+'ms')\"",
    "test:import": "node test-chatImport.js"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.5.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "private": true
}
