{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/",
        "destination": "/checkin-guest",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firebase-debug*.log",
      "**/.*",
      "serviceAccountKey.json",
      "node_modules/**",
      "tuya-functions/**",
      "pipeline-functions/**",
      "sandbox_rebuild/**",
      "scripts/**",
      "index.html",
      "clear-reservations.html",
      "import-reservations.html",
      "checkin-admin-backup.html",
      "checkin-admin-legacy.html",
      "admin-search-test.html",
      "tuya-test.html",
      "SleepyDashboard.html",
      "SleepyPMS.html",
      "TukaTracker.html",
      "VenuTracker Update.html",
      "sandbox-index.html",
      "SYSTEM_MAP.html",
      "SYSTEM_MAP_CURSOR.html",
      "checkin-guest-sandbox.html",
      "checkin-guest-sandbox-2.html",
      "checkin-guest-sandbox-3.html",
      "checkin-admin-sandbox.html",
      "HK-legacy.html",
      "hk-manage.html",
      "*.md",
      "*.py",
      "*.json",
      "*.yml",
      "*.patch*",
      "CNAME"
    ]
  },
  "functions": [
    {
      "source": "tuya-functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "pipeline-functions",
      "codebase": "pipeline",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "tests"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
